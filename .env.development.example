# ===== DEVELOPMENT =====
# copy thành .env.development (không commit file thật)
NODE_ENV=development
PORT=9000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
ENABLE_SWAGGER=true

# Postgres local (5433 vì 5432 mặc định hay bị PostgreSQL cài native trên máy chiếm)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=meago_dev
# dev cho phép sync schema để iterate nhanh
DB_SYNCHRONIZE=true

# Redis local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth — secret dev, KHÔNG dùng cho prod
JWT_ACCESS_SECRET=dev-only-secret-change-me-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_ISSUER=meago-server
JWT_AUDIENCE=meago-client
JWT_REFRESH_TTL_DAYS=14
JWT_REFRESH_RACE_GRACE_SECONDS=5
JWT_REFRESH_COOKIE_NAME=meago_rt

# Auth mode: jwt (Bearer + refresh rotation) | session (opaque cookie + Redis cache)
AUTH_MODE=jwt
SESSION_COOKIE_NAME=meago_sid
SESSION_IDLE_TTL_MINUTES=30
SESSION_ABSOLUTE_TTL_DAYS=14
SESSION_TOUCH_INTERVAL_SECONDS=60
SESSION_CACHE_TTL_SECONDS=300

# RBAC
PERMISSION_CACHE_TTL_MS=300000
AUTH_LOCK_TIMEOUT_MS=5000

# Bootstrap data local (npm run seed)
BOOTSTRAP_ADMIN_EMAIL=admin@meago.local
BOOTSTRAP_ADMIN_DISPLAY_NAME=Meago Administrator
BOOTSTRAP_ADMIN_PASSWORD=local-admin-change-me

# Observability — để trống DSN thì Sentry bị vô hiệu hóa
APP_RELEASE=development
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
