# ===== DEVELOPMENT =====
# copy thành .env.development (không commit file thật)
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# Postgres local
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=meago_dev
# dev cho phép sync schema để iterate nhanh
DB_SYNCHRONIZE=true

# Redis local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth — secret dev, KHÔNG dùng cho prod
JWT_ACCESS_SECRET=dev-only-secret-change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_COOKIE_NAME=meago_rt

# RBAC
PERMISSION_CACHE_TTL_MS=300000
