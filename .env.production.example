# ===== PRODUCTION =====
# Khuyến nghị: KHÔNG dùng file .env.production trên server —
# inject biến môi trường qua container/CI secret manager (biến hệ thống
# luôn ưu tiên hơn file). File này chỉ liệt kê các biến bắt buộc.
NODE_ENV=production
PORT=9000
API_PREFIX=api
CORS_ORIGINS=https://meago.example.com

DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=meago
# prod TUYỆT ĐỐI không sync schema — dùng npm run migration:run
DB_SYNCHRONIZE=false

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_COOKIE_NAME=meago_rt

PERMISSION_CACHE_TTL_MS=300000
 