# ===== PRODUCTION =====
# Khuyến nghị: KHÔNG dùng file .env.production trên server —
# inject biến môi trường qua container/CI secret manager (biến hệ thống
# luôn ưu tiên hơn file). File này chỉ liệt kê các biến bắt buộc.
NODE_ENV=production
PORT=9000
API_PREFIX=api
CORS_ORIGINS=https://meago.example.com
TRUST_PROXY_HOPS=1
ENABLE_SWAGGER=false

DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
# Container secret thay thế: DB_PASSWORD_FILE=/run/secrets/db_password
DB_DATABASE=meago
# prod TUYỆT ĐỐI không sync schema — dùng npm run migration:run
DB_SYNCHRONIZE=false

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# Container secret thay thế: REDIS_PASSWORD_FILE=/run/secrets/redis_password
REDIS_DB=0

# sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# Container secret thay thế: JWT_ACCESS_SECRET_FILE=/run/secrets/jwt_access_secret
JWT_ACCESS_TTL=15m
JWT_ISSUER=meago-server
JWT_AUDIENCE=meago-client
JWT_REFRESH_TTL_DAYS=14
JWT_REFRESH_RACE_GRACE_SECONDS=5
JWT_REFRESH_COOKIE_NAME=meago_rt

# Auth mode: jwt (Bearer + refresh rotation) | session (opaque cookie + Redis cache)
AUTH_MODE=jwt
SESSION_COOKIE_NAME=meago_sid
SESSION_IDLE_TTL_MINUTES=30
SESSION_ABSOLUTE_TTL_DAYS=14
SESSION_TOUCH_INTERVAL_SECONDS=60
SESSION_CACHE_TTL_SECONDS=300

PERMISSION_CACHE_TTL_MS=300000
AUTH_LOCK_TIMEOUT_MS=5000

# Bootstrap system data (required on first production deployment)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Meago Administrator
BOOTSTRAP_ADMIN_PASSWORD=
# Container secret thay thế: BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password

# Observability
APP_RELEASE=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
