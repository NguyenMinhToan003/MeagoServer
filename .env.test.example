# ===== TEST (e2e) =====
# copy thành .env.test (không commit file thật)
# Dùng chung Postgres/Redis local (docker compose up -d postgres redis) với DB riêng.
NODE_ENV=test
PORT=9001
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
ENABLE_SWAGGER=false

# Postgres local — database riêng cho test, tách khỏi meago_dev
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=meago_test
# test cho phép sync schema — mỗi lần chạy dựng lại schema sạch
DB_SYNCHRONIZE=true

# Redis local — DB index riêng để không đụng data dev
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Auth — secret test, KHÔNG dùng cho prod
JWT_ACCESS_SECRET=test-only-secret-change-me-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_ISSUER=meago-server-test
JWT_AUDIENCE=meago-client-test
JWT_REFRESH_TTL_DAYS=14
JWT_REFRESH_RACE_GRACE_SECONDS=5
JWT_REFRESH_COOKIE_NAME=meago_rt

# Auth mode: jwt (Bearer + refresh rotation) | session (opaque cookie + Redis cache)
AUTH_MODE=jwt
SESSION_COOKIE_NAME=meago_sid
SESSION_IDLE_TTL_MINUTES=30
SESSION_ABSOLUTE_TTL_DAYS=14
SESSION_TOUCH_INTERVAL_SECONDS=60
SESSION_CACHE_TTL_SECONDS=300

# RBAC
PERMISSION_CACHE_TTL_MS=300000
AUTH_LOCK_TIMEOUT_MS=5000

# Không gửi telemetry trong test
APP_RELEASE=test
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
