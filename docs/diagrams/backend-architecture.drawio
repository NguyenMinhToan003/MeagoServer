                <mxCell id="auth-refresh-18" value="12. POST /auth/logout (cookie) → revoke 1 session · /logout-all (Bearer) → revoke mọi session của user" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.7857;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7857;entryDx=0;entryDy=0;" parent="1" source="auth-refresh-2" target="auth-refresh-3" edge="1">
