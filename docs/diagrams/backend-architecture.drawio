                <mxCell id="auth-refresh-title" value="AUTH · VÒNG ĐỜI TOKEN — POST /auth/refresh · /auth/logout · /auth/logout-all" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2A44;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="auth-refresh-sub" value="Cùng route ở cả hai mode; AUTH_STRATEGY.renew/signOut/revokeAll quyết định. JWT: rotate refresh token trong family + phát hiện dùng lại. Session: rotate ID giữ absolute + touch trượt idle." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7385;" parent="1" vertex="1">
                    <mxGeometry x="40" y="58" width="1300" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="auth-refresh-1" value="AUTH_MODE=jwt · refresh rotation · auth.service.ts (JwtAuthStrategy bọc)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF1E6;strokeColor=#B25E09;fontColor=#B25E09;fontStyle=1;fontSize=13;align=left;spacingLeft=10;" parent="1" vertex="1">
