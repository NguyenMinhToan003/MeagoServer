    <diagram id="auth-overview" name="Auth · Overview">
        <mxGraphModel dx="1000" dy="774" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="auth-overview-1" value="AUTH · TỔNG QUAN 4 LUỒNG × 2 MODE" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2A44;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-2" value="AUTH_MODE chọn một bộ (adapter, strategy, http transport) tại AuthModule. Controller/guard không có if(mode). Mỗi ô ghi tên page chi tiết trong file này." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7385;" parent="1" vertex="1">
                    <mxGeometry x="40" y="58" width="1300" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-3" value="Luồng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F7;strokeColor=#DDE1E8;fontColor=#6B7385;fontStyle=1;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="40" y="110" width="250" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-4" value="&lt;b&gt;AUTH_MODE=jwt&lt;/b&gt; · stateless&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Bearer header · refresh_sessions · 0 I/O mỗi request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF1E6;strokeColor=#B25E09;fontColor=#B25E09;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="302" y="110" width="470" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-5" value="&lt;b&gt;AUTH_MODE=session&lt;/b&gt; · stateful&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cookie meago_sid · auth_sessions + Redis cache · revoke tức thì&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3F0;strokeColor=#0F7B6C;fontColor=#0F7B6C;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="784" y="110" width="470" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-6" value="&lt;b&gt;1 · Đăng nhập&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6B7385&quot;&gt;POST /auth/login&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6B7385&quot;&gt;→ page: Auth · Login&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDE1E8;fontColor=#1F2A44;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="178" width="250" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-7" value="Xác minh email/password chung (Argon2id + dummy verify).&lt;br&gt;Lock user → INSERT refresh_sessions (family mới, sha256 token) → ký JWT 15m.&lt;br&gt;Trả {accessToken, expiresIn} + cookie meago_rt (path /api/v1/auth)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B25E09;fontColor=#1F2A44;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="302" y="178" width="470" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-8" value="Xác minh email/password chung.&lt;br&gt;sid 256-bit → INSERT auth_sessions (sha256, idle 30m, absolute 14d) → SADD user set, KHÔNG SET record.&lt;br&gt;Trả {expiresAt} + cookie meago_sid (path /)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7B6C;fontColor=#1F2A44;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="784" y="178" width="470" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-9" value="&lt;b&gt;2 · Xác minh mỗi request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6B7385&quot;&gt;AuthenticationGuard&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6B7385&quot;&gt;→ page: Auth · Request verification&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDE1E8;fontColor=#1F2A44;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="340" width="250" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-10" value="Authorization: Bearer → JwtAuthenticationAdapter.&lt;br&gt;Verify HS256 · iss · aud · exp · sub/sid/jti — 0 I/O.&lt;br&gt;Cookie bị bỏ qua. Không thu hồi được trước exp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B25E09;fontColor=#1F2A44;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="302" y="340" width="470" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-11" value="Cookie meago_sid → CsrfGuard → SessionAuthenticationAdapter.&lt;br&gt;GET auth:sess:{sha256} → miss/lỗi → SELECT auth_sessions → SET PX≤300s.&lt;br&gt;Touch ≥60s: UPDATE rồi DEL. Bearer bị bỏ qua." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7B6C;fontColor=#1F2A44;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="784" y="340" width="470" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-12" value="&lt;b&gt;3 · Vòng đời token&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6B7385&quot;&gt;/auth/refresh · /logout · /logout-all&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6B7385&quot;&gt;→ page: Auth · Refresh &amp; revoke&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDE1E8;fontColor=#1F2A44;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="502" width="250" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-13" value="Rotation trong family, expiresAt giữ nguyên (absolute).&lt;br&gt;Token cũ dùng lại: &lt;5s → 409 AUTH_REFRESH_RACE; muộn hơn → revoke cả family → 401.&lt;br&gt;Lock user → family → FOR UPDATE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B25E09;fontColor=#1F2A44;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="302" y="502" width="470" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-14" value="Rotate ID giữ absolute, idle = now+30m.&lt;br&gt;UPDATE cũ WHERE revokedAt IS NULL — affected=0 → 401 Session already rotated.&lt;br&gt;Sau commit: DEL key cũ, SADD key mới. logout-all: SMEMBERS → DEL mọi key." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7B6C;fontColor=#1F2A44;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="784" y="502" width="470" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-15" value="&lt;b&gt;4 · Phân quyền&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6B7385&quot;&gt;PermissionsGuard (chung 2 mode)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6B7385&quot;&gt;→ page: Auth · Authorization (RBAC)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDE1E8;fontColor=#1F2A44;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="664" width="250" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-16" value="Kiểm tra mỗi request: @RequirePermissions → getUserPermissions(subjectId) → GET rbac:perms:{uid} → miss → users→roles→permissions → SET TTL 5m → cần đủ TẤT CẢ → 403 &quot;Missing permissions&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B25E09;fontColor=#1F2A44;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="302" y="664" width="470" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-17" value="Admin đổi quyền: PUT /rbac/roles/:id/permissions (role:manage) · PUT /rbac/users/:id/roles (user:manage).&lt;br&gt;Lock row FOR UPDATE → validate → COMMIT → SAU COMMIT DEL rbac:perms:* hoặc rbac:perms:{uid}." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7B6C;fontColor=#1F2A44;fontSize=11;align=left;spacingLeft=10;spacingRight=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="784" y="664" width="470" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="auth-overview-18" value="&lt;b&gt;Bất biến chung&lt;/b&gt; · Raw credential không nằm trong DB/Redis/log (chỉ sha256) · Postgres là truth, Redis là cache: đọc SET kèm TTL, ghi commit trước rồi chỉ DEL · Redis lỗi → rơi về Postgres, không 503 · Mọi ghi auth_sessions qua SESSION_STORE, mọi ghi user_roles/role_permissions qua RbacService · Biến env: khái niệm chung có tiền tố JWT_ / SESSION_, biến dùng chung không tiền tố." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F7;strokeColor=#DDE1E8;fontColor=#1F2A44;fontSize=11;align=left;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="832" width="1214" height="70" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="auth-login" name="Auth · Login">
        <mxGraphModel dx="1000" dy="774" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="auth-login-title" value="AUTH · ĐĂNG NHẬP — POST /api/v1/auth/login" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2A44;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="auth-login-sub" value="Xác minh email/password chung (AuthService.authenticateCredentials, Argon2id + dummy verify). Khác nhau từ AUTH_STRATEGY.signIn. Controller/guard không có if(mode)." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7385;" parent="1" vertex="1">
                    <mxGeometry x="40" y="58" width="1300" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="auth-login-1" value="AUTH_MODE=jwt · stateless · jwt-auth.strategy.ts · jwt-http.transport.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF1E6;strokeColor=#B25E09;fontColor=#B25E09;fontStyle=1;fontSize=13;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="auth-login-2" value="Client" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;rounded=1;fillColor=#FFFFFF;strokeColor=#B25E09;fontColor=#1F2A44;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="140" width="140" height="510" as="geometry"/>
                </mxCell>
                <mxCell id="auth-login-3" value="AuthController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;rounded=1;fillColor=#FFFFFF;strokeColor=#B25E09;fontColor=#1F2A44;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="230" y="140" width="140" height="510" as="geometry"/>
                </mxCell>
                <mxCell id="auth-login-4" value="AuthService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;rounded=1;fillColor=#FFFFFF;strokeColor=#B25E09;fontColor=#1F2A44;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="420" y="140" width="140" height="510" as="geometry"/>
                </mxCell>
                <mxCell id="auth-login-5" value="JwtAuthStrategy" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;rounded=1;fillColor=#FFFFFF;strokeColor=#B25E09;fontColor=#1F2A44;fontSize=12;fontStyle=1;" parent="1" vertex="1">
