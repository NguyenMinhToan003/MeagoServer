                <mxCell id="auth-rbac-title" value="AUTH · PHÂN QUYỀN — PermissionsGuard + cache rbac:perms + invalidate sau commit" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2A44;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="auth-rbac-sub" value="Chạy SAU AuthenticationGuard, giống nhau ở cả hai AUTH_MODE: chỉ cần AuthPrincipal.subjectId. Permission là data &quot;resource:action&quot;; code không hardcode role. Redis lỗi → fail-open về DB." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7385;" parent="1" vertex="1">
                    <mxGeometry x="40" y="58" width="1300" height="26" as="geometry"/>
                </mxCell>
