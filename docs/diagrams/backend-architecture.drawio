                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth-rbac-34" value="10. BEGIN · SELECT user FOR UPDATE · SELECT roles IN (…) · save user_roles · COMMIT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.7025;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7025;entryDx=0;entryDy=0;" parent="1" source="auth-rbac-22" target="auth-rbac-23" edge="1">
