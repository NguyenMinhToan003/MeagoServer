                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth-refresh-14" value="8. revokedAt? expiresAt quá hạn? user không ACTIVE? → 401 (+ revoke family)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF1E6;strokeColor=#B25E09;fontColor=#1F2A44;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="498" y="488" width="230" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="auth-refresh-15" value="9. INSERT session mới: cùng familyId, expiresAt = CŨ (absolute)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.5933;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5933;entryDx=0;entryDy=0;" parent="1" source="auth-refresh-4" target="auth-refresh-5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth-refresh-16" value="10. UPDATE cũ SET revokedAt=now, replacedBy=id mới · COMMIT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.6574;exitDx=0;exitDy=0;entryX=0.5;entryY=0.6574;entryDx=0;entryDy=0;" parent="1" source="auth-refresh-4" target="auth-refresh-5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth-refresh-17" value="11. {accessToken mới, expiresIn} + Set-Cookie meago_rt=RT_new" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.7216;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7216;entryDx=0;entryDy=0;" parent="1" source="auth-refresh-3" target="auth-refresh-2" edge="1">
