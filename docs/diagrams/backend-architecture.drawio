                <mxCell id="auth-rbac-26" value="2. setRolePermissions(roleId, names)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.1542;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1542;entryDx=0;entryDy=0;" parent="1" source="auth-rbac-21" target="auth-rbac-22" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth-rbac-27" value="3. BEGIN · SELECT role FOR UPDATE" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.2227;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2227;entryDx=0;entryDy=0;" parent="1" source="auth-rbac-22" target="auth-rbac-23" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth-rbac-28" value="4. SELECT permissions WHERE name IN (…) → thiếu → 400 RBAC_UNKNOWN_PERMISSION" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.2913;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2913;entryDx=0;entryDy=0;" parent="1" source="auth-rbac-22" target="auth-rbac-23" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth-rbac-29" value="5. save role_permissions · COMMIT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.3598;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3598;entryDx=0;entryDy=0;" parent="1" source="auth-rbac-22" target="auth-rbac-23" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth-rbac-30" value="6. SAU COMMIT: SCAN+DEL rbac:perms:*  (mọi user mang role)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.4283;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4283;entryDx=0;entryDy=0;" parent="1" source="auth-rbac-22" target="auth-rbac-24" edge="1">
