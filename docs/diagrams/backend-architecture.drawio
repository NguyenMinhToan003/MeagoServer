                <mxCell id="auth-refresh-33" value="alt affected = 0 (renew đồng thời khác đã thắng)" style="shape=umlFrame;whiteSpace=wrap;html=1;width=150;height=22;fontSize=11;fontStyle=1;strokeColor=#6B7385;fontColor=#6B7385;fillColor=none;dashed=1;" parent="1" vertex="1">
