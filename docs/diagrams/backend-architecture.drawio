                <mxCell id="auth-refresh-30" value="4. revokedAt? idle quá hạn? absolute quá hạn? → 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3F0;strokeColor=#0F7B6C;fontColor=#1F2A44;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="1338" y="312" width="230" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="auth-refresh-31" value="5. SID_new = random 32B; record mới: absolute = CŨ, idle = now+30m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3F0;strokeColor=#0F7B6C;fontColor=#1F2A44;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="1338" y="356" width="230" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="auth-refresh-32" value="6. BEGIN · UPDATE cũ SET revokedAt, replacedBy WHERE revokedAt IS NULL" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.4283;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4283;entryDx=0;entryDy=0;" parent="1" source="auth-refresh-24" target="auth-refresh-25" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
