                    <mxGeometry x="230" y="140" width="140" height="686" as="geometry"/>
                </mxCell>
                <mxCell id="auth-refresh-4" value="AuthService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;rounded=1;fillColor=#FFFFFF;strokeColor=#B25E09;fontColor=#1F2A44;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="420" y="140" width="140" height="686" as="geometry"/>
                </mxCell>
                <mxCell id="auth-refresh-5" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;rounded=1;fillColor=#FFFFFF;strokeColor=#B25E09;fontColor=#1F2A44;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="610" y="140" width="140" height="686" as="geometry"/>
                </mxCell>
                <mxCell id="auth-refresh-6" value="1. POST /auth/refresh — cookie meago_rt=RT_old" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.0802;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0802;entryDx=0;entryDy=0;" parent="1" source="auth-refresh-2" target="auth-refresh-3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth-refresh-7" value="2. renew({kind: refresh, token})" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.1443;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1443;entryDx=0;entryDy=0;" parent="1" source="auth-refresh-3" target="auth-refresh-4" edge="1">
