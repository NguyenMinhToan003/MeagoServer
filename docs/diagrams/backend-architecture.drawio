                <mxCell id="auth-refresh-27" value="1. POST /auth/refresh — cookie meago_sid=SID_old + X-Requested-With" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.0857;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0857;entryDx=0;entryDy=0;" parent="1" source="auth-refresh-21" target="auth-refresh-22" edge="1">
