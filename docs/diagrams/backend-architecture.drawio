                <mxCell id="auth-rbac-31" value="7. IRole  · audit rbac.role.set_permissions" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.4969;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4969;entryDx=0;entryDy=0;" parent="1" source="auth-rbac-21" target="auth-rbac-20" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="auth-rbac-32" value="8. PUT /rbac/users/:id/roles {roleIds[]}  (user:manage)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;edgeStyle=none;strokeColor=#1F2A44;fontColor=#1F2A44;fontSize=11;exitX=0.5;exitY=0.5654;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5654;entryDx=0;entryDy=0;" parent="1" source="auth-rbac-20" target="auth-rbac-21" edge="1">
